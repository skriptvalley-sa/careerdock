# Server
PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://careerdock:careerdock@localhost:5432/careerdock?sslmode=disable

# Redis
REDIS_URL=localhost:6379

# Auth
JWT_SECRET=change-me-in-production

# AI Providers
CLAUDE_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Payments
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Email
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@careerdock.skriptvalley.com

# S3 / MinIO (local dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_RESUME_BUCKET=careerdock-resumes
S3_LOGO_BUCKET=careerdock-logos
S3_USE_PATH_STYLE=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (requests per minute; defaults: IP=300, user=600)
# Rate limiting — fixed 60-second window per IP / per authenticated user.
# IP limit covers unauthenticated browsing. User limit covers logged-in sessions.
# The SPA makes ~5-15 API calls per page load; 120/600 leaves plenty of headroom.
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_USER_PER_MIN=600

# Sentry
SENTRY_DSN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Admin seed — used on first start to bootstrap the initial admin user.
# Safe to keep in production; rotate/unset ADMIN_PASSWORD after first boot.
ADMIN_EMAIL=root@example.com
ADMIN_NAME=Root Admin
ADMIN_PASSWORD=change-me-strong-password
